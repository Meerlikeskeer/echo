{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "echo-web-app"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "doctor": "npm run doctor --workspace @echo/web",
    "dev": "npm run dev --workspace @echo/web",
    "start": "npm run start --workspace @echo/web",
    "lint": "npm run lint --workspace @echo/web",
    "typecheck": "npm run typecheck --workspace @echo/web",
    "test": "npm run test --workspace @echo/web",
    "build": "npm run build --workspace @echo/web",
    "test:production": "node --test scripts/production.test.mjs",
    "selfhost:assemble": "node scripts/selfhost-assemble.mjs",
    "selfhost:start": "node echo-web-app/.next/standalone/echo-web-app/server.js",
    "test:selfhost": "node --test scripts/selfhost.test.mjs",
    "check:tracked": "node scripts/check-source-tracked.mjs",
    "test:deployed": "node scripts/deployed-smoke.mjs",
    "check": "npm run check:tracked && npm run tasks:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:production && npm run test:selfhost",
    "tasks:build": "node scripts/tasks.mjs",
    "tasks:check": "node scripts/tasks.mjs --check",
    "floor": "node scripts/verification-floor.mjs",
    "floor:check": "node scripts/verification-floor.mjs --check"
  }
}
