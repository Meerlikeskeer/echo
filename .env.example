# Copy to apps/web/.env.local (ignored). Only ECHO_OWNER_* is consumed by WEB-001.
# All provider/retention names below are reserved for later tasks.
ECHO_OWNER_USERNAME=
# Required: a random password of at least 32 characters; server-only, TLS outside localhost.
ECHO_OWNER_PASSWORD=
# Fill secrets locally. Never use NEXT_PUBLIC_* for secrets.
# Adapter/provider names and model IDs are intentionally undecided.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
REMINDER_PROVIDER=
REMINDER_CLIENT_ID=
REMINDER_CLIENT_SECRET=
# Provisional default; enforce permitted range 7–30 in implementation.
AUDIO_RETENTION_DAYS=14
# Set during WEB-010; no deletion until warning/copy guards are implemented.
STORAGE_WARNING_THRESHOLD_PERCENT=
DELETION_WARNING_GRACE_HOURS=
