# Copy to apps/web/.env.local (ignored). ECHO_OWNER_* and the TRANSCRIPTION_*
# and LLM_* groups are consumed today; the remaining names are reserved for
# later tasks. Provider configuration is validated at startup: if it is
# incomplete, recording is disabled and the missing variables are named.
#
# ENG-019: this file is named `env.example`, without a leading dot, and that is
# deliberate. It used to be `.env.example`. Agent sandboxes deny writes to every
# path matching `.env*` — a correct rule, since that is where secrets live — but
# the rule matched this template too, and the template is *tracked*. So any
# sandboxed agent checking the repository out into a new worktree failed on
# `error: unable to create file .env.example: Operation not permitted`, before
# it could run a single test. A secret-free template is the one `.env` file that
# has to be readable and writable by everyone, so it no longer looks like one.
ECHO_OWNER_USERNAME=
# Required: a random password of at least 32 characters; server-only, TLS outside localhost.
ECHO_OWNER_PASSWORD=
# Fill secrets locally. Never use NEXT_PUBLIC_* for secrets.
# Adapter id: `openai-compatible` serves hosted vendors and self-hosted servers
# alike, or `fixture` for deterministic canned output with no network access.
# The permanent vendor is still undecided (ADR-009); the default is Temporary.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
# Base URL is what makes providers swappable (ADR-009). Without it the
# OpenAI-compatible wire format buys nothing. Hosted example:
#   TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# Fully local, no external processor:
#   TRANSCRIPTION_BASE_URL=http://localhost:8000/v1
TRANSCRIPTION_BASE_URL=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Same pattern. Hosted example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
# A local runtime is typically http://localhost:11434/v1
#
# WEB-017: this port now receives a whole session at once. An hour of speech is
# roughly 55,000 characters and Echo sends all of it rather than truncating, so
# it refuses past 400,000 and the model refuses anything past its own window.
# Pick a notes model whose context window covers the sessions you record. A
# large-context option speaking this same wire format:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# The vendor remains an open decision (ADR-009); this is configuration, not a
# choice recorded in code.
LLM_BASE_URL=
# Session-scoped diarization (ADR-009). Not required before WEB-005; leave blank.
DIARIZATION_PROVIDER=
DIARIZATION_BASE_URL=
DIARIZATION_API_KEY=
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
REMINDER_PROVIDER=
REMINDER_CLIENT_ID=
REMINDER_CLIENT_SECRET=
# Provisional default; enforce permitted range 7–30 in implementation.
AUDIO_RETENTION_DAYS=14
# Set during WEB-010; no deletion until warning/copy guards are implemented.
STORAGE_WARNING_THRESHOLD_PERCENT=
DELETION_WARNING_GRACE_HOURS=
