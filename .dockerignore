# Keep the build context small, reproducible, and free of anything secret.
# Everything the image needs is installed from package-lock.json and built
# inside the container.

.git
.github
.claude

node_modules
echo-web-app/node_modules
.next
echo-web-app/.next
out
dist
build
coverage
*.tsbuildinfo

# The web image does not need firmware, device builds or the native app folder.
/echo-device/
/echo-mac-app/

# Never send local credentials into a build context.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets/

# Recordings and local data must never enter an image.
recordings/
uploads/
local-data/
*.wav
*.mp3
*.m4a
*.webm
*.ogg
*.flac
*.sqlite
*.sqlite3
*.db

__pycache__/
*.pyc
.agent-runs/

.DS_Store
.idea/
.vscode/
*.log
